{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The conversion modules and the engine they build on both live in the website package —
    // see README.md. This alias is the ONLY coupling, and it is one-directional: nothing under
    // client/ imports this tool. When they are extracted to a package, this is the line to change.
    "paths": {
      "src/*": ["../../client/src/*"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["*.ts", "__tests__/**/*.ts"]
}
