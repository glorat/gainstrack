{
  "name": "@gainstrack/cli",
  "version": "0.1.0",
  "description": "Headless CLI over the gainstrack engine: turns a .gainstrack ledger into the primary financial statements as JSON, plus beancount/gainstrack export and a golden figures check. Imports the engine from client/src/lib; adds no logic of its own.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "gainstrack": "esbuild cli.ts --bundle --platform=node --format=cjs --alias:src=../../client/src --alias:@js-joda/core=../../client/node_modules/@js-joda/core --log-level=warning --outfile=node_modules/.cache/gainstrack-cli/cli.cjs && node node_modules/.cache/gainstrack-cli/cli.cjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.7",
    "@types/node": "^24.13.2",
    "esbuild": "^0.27.2",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">= 24"
  }
}
