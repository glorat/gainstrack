{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The engine lives in the website package — see README.md. This alias is the ONLY coupling, and
    // it is one-directional: nothing under client/ imports this tool. Import leaf modules only
    // (gen/, AllStateEx, statements/, cashflow, export/) — an `assetdb` barrel would pull in Vue.
    // When the engine is extracted to a package, this is the line to change.
    "paths": {
      "src/*": ["../../client/src/*"],
      // Share the client's single @js-joda/core so LocalDate instances cross the boundary as one
      // type/runtime identity — cli.ts creates dates and hands them to engine code, and two copies
      // (even same version) would be unrelated types and fail `instanceof` at runtime.
      "@js-joda/core": ["../../client/node_modules/@js-joda/core"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["*.ts", "__tests__/**/*.ts"]
}
