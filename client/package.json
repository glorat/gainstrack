{
  "name": "@glorat/gainstrack",
  "version": "3.16.2",
  "description": "Gainstrack",
  "productName": "Gainstrack",
  "author": "Kevin Tam <kevin@glorat.net>",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "eslint .",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:unit:ci": "vitest run --reporter=verbose",
    "fixtures:local": "DUMP_LOCAL_FIXTURES=1 vitest run src/lib/__tests__/dumpLocalFixtures.spec.ts --reporter=verbose",
    "test:rules": "firebase emulators:exec --only firestore --project gainstrack-rules-test \"vitest run src/lib/ledger/__tests__/firestoreRules.spec.ts\"",
    "type-check": "vue-tsc --noEmit",
    "fixtures:fuzz": "DUMP_FUZZ_CORPUS=1 vitest run src/lib/__tests__/dumpFuzzCorpus.spec.ts --reporter=verbose"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@glorat/boglebot": "^1.0.1",
    "@js-joda/core": "^6.1.0",
    "@quasar/extras": "^1.18.0",
    "@sentry/vue": "^10.70.0",
    "@types/lodash": "^4.17.25",
    "axios": "^1.19.0",
    "codemirror": "^6.0.2",
    "csv-stringify": "^6.8.3",
    "decimal.js": "^10.6.0",
    "firebase": "^12.17.1",
    "lodash": "^4.18.1",
    "markdown-it": "^14.3.0",
    "mitt": "^3.0.1",
    "numbro": "^2.5.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "plotly.js-dist": "^3.7.0",
    "quasar": "^2.25.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@quasar/app-vite": "^2.6.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  },
  "browserslist": [
    "last 10 Chrome versions",
    "last 10 Firefox versions",
    "last 4 Edge versions",
    "last 7 Safari versions",
    "last 8 Android versions",
    "last 8 ChromeAndroid versions",
    "last 8 FirefoxAndroid versions",
    "last 10 iOS versions",
    "last 5 Opera versions"
  ],
  "engines": {
    "node": ">= 24",
    "pnpm": ">= 8"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
